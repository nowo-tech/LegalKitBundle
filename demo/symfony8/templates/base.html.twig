{#-
  REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell (@NowoUiKit/demo_platform/layout.html.twig):
  the same top bar, aside, content width, theme and footer as every other nowo-tech bundle demo. This file only declares
  the demo (nowo_ui_demo_platform), the footer with the LegalKit footer navigation (REQ-CC-014) and, outside the admin
  pages, the CookieConsent widget (kept as the bundle ships it). It is also the layout of every LegalKit page
  (nowo_ui_kit.layouts.admin / guest, REQ-UI-003).
-#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set _nav = [
    {label: 'demo.nav.home', route: 'homepage', section: 'demo.nav.section_demo'},
] %}
{% for _link in nowo_legal_kit_links() %}
    {% set _nav = _nav|merge([{label: _link.label, href: _link.url, section: 'demo.nav.section_public', testid: 'demo-nav-legal-' ~ _link.slug}]) %}
{% endfor %}
{% if app.user %}
    {% set _nav = _nav|merge([
        {label: 'demo.nav.admin', route: 'nowo_legal_kit_admin_index', active: ['nowo_legal_kit_admin_*'], section: 'demo.nav.section_admin'},
        {label: 'demo.nav.ops', route: 'demo_ops', section: 'demo.nav.section_admin'},
    ]) %}
{% endif %}
{% set nowo_ui_demo_platform = {
    bundle: 'Legal Kit',
    home_route: 'homepage',
    repository: 'https://github.com/nowo-tech/LegalKitBundle',
    translation_domain: 'messages',
    locales: [
        {code: 'en', href: path('legal_notice_unlocalized')},
        {code: 'es', href: path('legal_notice', {_locale: 'es'})},
        {code: 'de', href: path('legal_notice', {_locale: 'de'})},
    ],
    auth: {login_route: 'demo_login', logout_route: 'demo_logout'},
    nav: _nav,
} %}

{% block nowo_ui_document_title %}{% block title %}{{ 'demo.title'|trans }}{% endblock %} — Symfony 8{% endblock %}

{#- The footer carries the legal navigation of the bundle (REQ-CC-014) with UiKit's footer partial. -#}
{% block nowo_ui_demo_platform_footer %}
    {% set _footer_links = [] %}
    {% for _link in nowo_legal_kit_links() %}
        {% set _footer_links = _footer_links|merge([{label: _link.label, href: _link.url, attr: {'data-nowo-legal-link': _link.slug}}]) %}
    {% endfor %}
    {% set _consent = nowo_legal_kit_consent_widget() %}
    {% set _cookies = nowo_legal_kit_links()|filter(l => l.slug == 'cookies')|first %}
    {% if _consent %}
        {% set _footer_links = _footer_links|merge([{label: 'nav.manage_cookies'|trans({}, 'NowoLegalKitBundle'), href: _cookies ? _cookies.url : '#', attr: {'data-nowo-open-consent': '', 'data-nowo-legal-link': 'manage-cookies'}}]) %}
    {% elseif _cookies %}
        {% set _footer_links = _footer_links|merge([{label: 'nav.manage_cookies'|trans({}, 'NowoLegalKitBundle'), href: _cookies.url, attr: {'data-nowo-legal-link': 'manage-cookies'}}]) %}
    {% endif %}
    {{ include('@NowoUiKitBundle/partials/_footer.html.twig', {
        brand: 'demo_platform.footer'|trans({'%platform%': 'nowo · bundles', '%bundle%': 'Legal Kit'}, 'NowoUiKitBundle'),
        links: _footer_links,
        nav_label: 'nav.label'|trans({}, 'NowoLegalKitBundle'),
        copyright: '© 2026 ' ~ 'demo.brand'|trans,
    }, false) }}
{% endblock %}

{% block nowo_ui_modals %}
    {% set _page = app.request.attributes.get('_route') %}
    {% if not (_page starts with 'nowo_legal_kit_admin' or _page == 'demo_ops') and nowo_cookie_consent_should_embed_modal() %}
        {{ render(path('nowo_cookie_consent.show_if_not_set')) }}
    {% endif %}
{% endblock %}
