{#
  Demo bridge of the UiKit guest layout (REQ-UI-003): Bootstrap from a CDN (demo only — the bundle never loads one),
  the demo navbar and footer around the canonical blocks, and the CookieConsent widget.
#}
{% extends '@NowoUiKit/layout/guest.html.twig' %}
{% import '_chrome.html.twig' as chrome %}

{% block nowo_ui_styles %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('demo.css') }}">
{% endblock %}

{% block nowo_ui_body %}
    {{ chrome.navbar() }}
    <div class="container py-4">{{ parent() }}</div>
    {{ chrome.footer() }}
    {% if nowo_cookie_consent_should_embed_modal() %}
        {{ render(path('nowo_cookie_consent.show_if_not_set')) }}
    {% endif %}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
