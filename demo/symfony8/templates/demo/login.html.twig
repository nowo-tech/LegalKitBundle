{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.nav.login'|trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'demo.nav.login'|trans, intro: 'demo.login.hint'|trans}) }}
{% endblock %}

{% block body %}
    {% if login_error %}
        <div class="nowo-ui-flash nowo-ui-flash--error" role="alert">{{ login_error.messageKey|trans(login_error.messageData, 'security') }}</div>
    {% endif %}
    <section class="nowo-ui-card" data-testid="demo-login">
        <div class="nowo-ui-card__body">
            {{ form_start(login_form) }}
                {% for child in login_form %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(login_form) }}
        </div>
    </section>
{% endblock %}
