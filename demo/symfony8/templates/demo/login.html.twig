{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.nav.login'|trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'demo.nav.login'|trans, intro: 'demo.login.hint'|trans}) }}
{% endblock %}

{% block nowo_ui_flashes %}
    {{ include('@NowoUiKit/demo_platform/_flashes.html.twig', {flash_messages: login_error ? {error: [login_error.messageKey|trans(login_error.messageData, 'security')]} : null}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.nav.login'|trans, kind: 'form', testid: 'demo-login', login_form: login_form} %}
        {% block section_body %}
            {{ form_start(login_form, {attr: {id: 'demo-login-form'}}) }}
                {% for child in login_form %}
                    {% if not child.rendered and child.vars.name != 'submit' %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(login_form, {render_rest: false}) }}
        {% endblock %}
        {% block section_footer %}{{ form_widget(login_form.submit, {attr: {form: 'demo-login-form'}}) }}{% endblock %}
    {% endembed %}
{% endblock %}
