{% extends nowo_ui_layout.guest %}

{% block nowo_ui_document_title %}{{ 'demo.nav.login'|trans }}{% endblock %}

{% block nowo_ui_content %}
    <div class="demo-login" data-testid="demo-login">
        <h1 class="h4 mb-3">{{ 'demo.nav.login'|trans }}</h1>
        <p class="text-muted small">{{ 'demo.login.hint'|trans }}</p>
        {% if login_error %}
            <div class="alert alert-danger">{{ login_error.messageKey|trans(login_error.messageData, 'security') }}</div>
        {% endif %}
        {{ form_start(login_form) }}
            {% for child in login_form %}
                {% if not child.rendered %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}
        {{ form_end(login_form) }}
    </div>
{% endblock %}
