{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.nav.ops'|trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'demo.nav.ops'|trans}) }}
{% endblock %}

{% block body %}
    <section data-testid="demo-ops">
        {{ include('@NowoLegalKitBundle/_placeholder_banner.html.twig') }}
        {% if nowo_legal_kit_placeholder_hits() is empty %}
            <p class="nowo-ui-flash nowo-ui-flash--success" role="status" data-testid="demo-ops-clear">{{ 'demo.ops.clear'|trans }}</p>
        {% endif %}
    </section>
{% endblock %}
