{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.nav.ops'|trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'demo.nav.ops'|trans, intro: 'demo.ops.intro'|trans}) }}
{% endblock %}

{% block body %}
    {% set _hits = nowo_legal_kit_placeholder_hits() %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.ops.placeholders'|trans, kind: 'content', empty: _hits is empty, state_message: 'demo.ops.clear'|trans, testid: 'demo-ops'} %}
        {% block section_body %}
            {{ include('@NowoLegalKitBundle/_placeholder_banner.html.twig') }}
        {% endblock %}
    {% endembed %}
{% endblock %}
