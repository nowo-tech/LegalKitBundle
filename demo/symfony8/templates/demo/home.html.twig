{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.title'|trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'demo.home.title'|trans, intro: 'demo.home.intro'|trans}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.home.public_title'|trans, kind: 'list', testid: 'demo-home'} %}
        {% block section_body %}
            <div class="nowo-ui-row-actions">
                {% for link in nowo_legal_kit_links() %}
                    <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ link.url }}">{{ link.label }}</a>
                {% endfor %}
            </div>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.home.admin_title'|trans, kind: 'content'} %}
        {% block section_body %}
            <p>{{ 'demo.home.admin'|trans }} <code class="nowo-ui-code">/admin/legal</code> (admin / admin)</p>
            <p>{{ 'demo.home.gate'|trans }} <code class="nowo-ui-code">bin/console nowo:legal-kit:check-placeholders</code></p>
        {% endblock %}
        {% block section_footer %}<a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('nowo_legal_kit_admin_index') }}">/admin/legal</a>{% endblock %}
    {% endembed %}
{% endblock %}
