{#
  Public legal page — a declared unique page (docs/TEMPLATES.md): extends the guest layout (public.layout_template
  ?? nowo_ui_layout.guest) and fills the canonical blocks. No JavaScript.
  Variables: page (Catalog\LegalPage), document (Document\ResolvedLegalDocument: title, body = sanitised HTML printed
  through |nowo_legal_kit_sanitize_html, source, contentLocale, updatedAt, version), alternates (locale => absolute URL), layout_template, legal_locale, prose_class (public.prose_class, ?string), plus the
  LegalPageRenderEvent template variables, and legal_header (Header\LegalPublicHeader::view(): brand, logo, home, sign_in;
  null unless public.header.enabled).
  Slots: section (article), muted (meta line), btn_link (cross navigation links); semantic classes nowo-legal-doc,
  nowo-legal-doc__meta, nowo-legal-nav (stylesheet css/nowo-legal-kit.css, asset package nowo_legal_kit).
#}
{% extends layout_template ?? nowo_ui_layout.guest %}
{% set nowo_ui_bundle = 'NowoLegalKitBundle' %}

{% block nowo_ui_document_title %}{{ document.title }}{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/nowo-legal-kit.css', 'nowo_legal_kit') }}">
{% endblock %}

{# MUX-150: the optional header (brand linked home, sign-in link) on top of the layout's own page header. #}
{% block nowo_ui_page_header %}
    {%- if legal_header|default(null) %}{{ include('@NowoLegalKitBundle/public/_header.html.twig', {header: legal_header, locale: legal_locale}, false) }}{% endif -%}
    {{- parent() -}}
{% endblock %}

{% block nowo_ui_content %}
    <article class="nowo-legal-doc{% if prose_class|default(null) %} {{ prose_class }}{% endif %} {{ nowo_ui_class('section', nowo_ui_bundle) }}" lang="{{ document.contentLocale }}" data-nowo-legal-source="{{ document.source }}" data-testid="nowo-legal-kit-page-{{ page.slug }}"{{ nowo_ui_attrs('section', nowo_ui_bundle) }}>
        {# Sanitised when resolved and again here (REQ-PBK-009); never print the body with |raw. The title is auto-escaped. #}
        {{ document.body|nowo_legal_kit_sanitize_html }}
        {% set _updated = document.isStored and document.updatedAt %}
        {% if _updated or document.version is not null %}
            <p class="nowo-legal-doc__meta {{ nowo_ui_class('muted', nowo_ui_bundle) }}"{{ nowo_ui_attrs('muted', nowo_ui_bundle) }}>
                {%- if _updated %}{{ 'public.last_updated'|trans({'%date%': document.updatedAt|date('Y-m-d')}, 'NowoLegalKitBundle', legal_locale) }}{% endif -%}
                {%- if _updated and document.version is not null %} · {% endif -%}
                {%- if document.version is not null %}{{ 'public.version'|trans({'%version%': document.version}, 'NowoLegalKitBundle', legal_locale) }}{% endif -%}
            </p>
        {% endif %}
        {{ include('@NowoLegalKitBundle/public/_nav.html.twig', {current: page.slug, locale: legal_locale}, false) }}
    </article>
{% endblock %}
